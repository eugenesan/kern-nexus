+static void cpp_dump_frame(const struct msm_cpp_frame_info_t *u,
+			   const uint32_t *msg)
+{
+	static u32 idx;
+	char path[80];
+	struct file *f;
+	loff_t pos = 0;
+	const struct cred *old;
+	int w;
+
+	if (cpp_dump_frames <= 0 || idx >= (u32)cpp_dump_frames)
+		return;
