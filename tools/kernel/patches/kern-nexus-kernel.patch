+		mm_segment_t old_fs = get_fs();
+		set_fs(KERNEL_DS);
+		w = vfs_write(f, (const char *)u, sizeof(*u), &pos);
+		if (w == sizeof(*u) && msg && u->msg_len)
+			w = vfs_write(f, (const char *)msg,
+				      sizeof(uint32_t) * u->msg_len, &pos);
+		set_fs(old_fs);
+	}
+	filp_close(f, NULL);
+	revert_creds(old);
