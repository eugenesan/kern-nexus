+ * small for a modern DTB (hammerhead's is ~176 KB).  kexec-tools puts
+ * the DTB in its own segment, so pass that address in r2 instead.
+ */
+static unsigned long kexec_dtb_address(struct kimage *image)
+{
+	(void)image;
